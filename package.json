{
  "name": "n8n-nodes-media-toolkit",
  "version": "1.2.0",
  "description": "n8n community node for media workflows: render MP4 video with ffmpeg, compute video render specs, and format platform-aware social captions",
  "main": "dist/nodes/index.js",
  "types": "dist/nodes/index.d.ts",
  "license": "MIT",
  "author": "Nimish Rangani",
  "homepage": "https://github.com/Media-Studios/n8n-nodes-media-toolkit",
  "repository": {
    "type": "git",
    "url": "https://github.com/Media-Studios/n8n-nodes-media-toolkit.git"
  },
  "bugs": {
    "url": "https://github.com/Media-Studios/n8n-nodes-media-toolkit/issues"
  },
  "n8n": {
    "nodes": [
      "dist/nodes/MediaToolkit/MediaToolkit.node.js"
    ],
    "credentials": [],
    "community": true
  },
  "scripts": {
    "build": "tsc && npm run build:icons",
    "build:icons": "copyfiles \"nodes/**/*.svg\" dist",
    "dev": "tsc --watch",
    "lint": "eslint nodes/**/*.ts",
    "test": "jest",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "n8n",
    "n8n-community-node",
    "media",
    "video",
    "metadata",
    "social-media",
    "captions"
  ],
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "devDependencies": {
    "n8n-workflow": "^2.16.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "copyfiles": "^2.4.1",
    "eslint": "^8.0.0",
    "jest": "^29.5.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.1.0"
  },
  "engines": {
    "node": ">=20.19.0",
    "npm": ">=9.0.0"
  }
}
